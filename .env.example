AWS_REGION=us-east-1
# LLM_PROVIDER can be "google" (Gemini 3.5 Flash via Vertex AI / Gemini API) or "bedrock" (Amazon Nova 2 Lite)
LLM_PROVIDER=google
GOOGLE_MODEL_ID=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
AGENTCORE_GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<account-id>:runtime/<runtime-id>
AGENTCORE_ENDPOINT_NAME=fact_checker_langchain_endpoint
